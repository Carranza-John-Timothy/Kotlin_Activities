<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".WelcomeActivity">

    <!-- Decorative Top Circle -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/header_curve_bg"
        android:backgroundTint="@color/secondaryColor"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-50dp"
        android:alpha="0.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Center Content -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_welcome_logo"
        app:layout_constraintBottom_toTopOf="@+id/welcomeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/welcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcomeMessage"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/primaryColor"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/welcomeSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoImage"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/welcomeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The best place to start your journey"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/textColorSecondary"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintTop_toBottomOf="@+id/welcomeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/welcomeLoginButton" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/welcomeLoginButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="40dp"
        android:text="@string/loginButton"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/white"
        android:backgroundTint="@color/primaryColor"
        app:cornerRadius="16dp"
        android:textAllCaps="false"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/welcomeRegisterButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/welcomeRegisterButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:text="@string/registerButton"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/primaryColor"
        android:backgroundTint="@color/white"
        app:strokeColor="@color/primaryColor"
        app:strokeWidth="2dp"
        app:cornerRadius="16dp"
        android:textAllCaps="false"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>